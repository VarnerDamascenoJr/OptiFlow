{
  "name": "optiflow",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de otimizacao operacional para cenarios de distribuicao e alocacao.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "api": "node scripts/start-api.js",
    "test": "node --test",
    "benchmark:compare": "node scripts/compare-strategies.js",
    "scenario:small": "node scripts/run-scenario.js data/scenarios/small-delivery.json",
    "scenario:small:history": "node scripts/run-scenario-history.js data/scenarios/small-delivery.json",
    "scenario:small:metrics": "OPTIFLOW_OUTPUT_FORMAT=prometheus node scripts/run-scenario.js data/scenarios/small-delivery.json",
    "scenario:small:risk": "node scripts/compare-risk.js data/scenarios/small-delivery.json",
    "scenario:small:simulate": "node scripts/simulate-plan.js data/scenarios/small-delivery.json"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "license": "UNLICENSED"
}
